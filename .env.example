# Frontend variables
# Points to the Django backend. Use http://127.0.0.1:8005/api for local development.
VITE_API_URL=http://127.0.0.1:8005/api

# Backend variables
# Cryptographic secret key for signing sessions and tokens
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-in-production

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://scrib-ni-roosc.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Production / Render deployment settings
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
# RENDER_EXTERNAL_HOSTNAME=scrib-backend.onrender.com
# DEBUG=False
